<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#CC000000" android:padding="12dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="FF VISION AI" android:textColor="#00FF88" android:textStyle="bold"/>
    <Button android:id="@+id/btn_start" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="ENTRAR NO JOGO"/>
    <CheckBox android:id="@+id/cb_esp" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="ESP (IA)" android:textColor="#FFF" android:checked="true"/>
    <CheckBox android:id="@+id/cb_aim" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Aimbot (IA)" android:textColor="#FFF" android:checked="true"/>
</LinearLayout>
